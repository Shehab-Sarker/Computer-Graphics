{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run OpenGL/GLUT Current File",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\output\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}\\freeglut\\bin;C:\\msys64\\ucrt64\\bin;C:\\Windows\\System32;C:\\Windows"
                }
            ],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "preLaunchTask": "Build OpenGL Current File",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}

